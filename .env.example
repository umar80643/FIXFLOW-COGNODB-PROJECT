# Put your CognoDB Bolt or Neo4j URI here.
# Examples:
# COGNODB_URI=bolt://localhost:7687
# COGNODB_URI=neo4j+s://your-instance.databases.neo4j.io
COGNODB_URI=bolt://localhost:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=change-me
COGNODB_DATABASE=neo4j
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
